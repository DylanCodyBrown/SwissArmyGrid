{
  "name": "swissarmygrid",
  "displayName": "SwissArmyGrid",
  "description": "Runs the SwissArmyGrid server while VS Code is open and shows its grids inside VS Code. Push any data file (CSV, JSON, Parquet, Arrow, Excel) to a grid from the button at the top of the file.",
  "version": "0.9.1",
  "publisher": "financial-insights",
  "license": "SEE LICENSE IN LICENSE.txt",
  "repository": {
    "type": "git",
    "url": "https://github.com/asurion-core/fi-claude-marketplace.git",
    "directory": "VSCode-Extensions/swissarmygrid"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "swissarmygrid.restart",
        "title": "Restart the server",
        "category": "SwissArmyGrid"
      },
      {
        "command": "swissarmygrid.updateServer",
        "title": "Update the server",
        "category": "SwissArmyGrid"
      },
      {
        "command": "swissarmygrid.pushFile",
        "title": "Push to SwissArmyGrid",
        "category": "SwissArmyGrid",
        "icon": "$(table)"
      },
      {
        "command": "swissarmygrid.showGrids",
        "title": "Open SwissArmyGrid",
        "category": "SwissArmyGrid",
        "icon": {
          "light": "media/swissarmygrid.svg",
          "dark": "media/swissarmygrid.svg"
        }
      },
      {
        "command": "swissarmygrid.openInChrome",
        "title": "Open SAG in Chrome",
        "category": "SwissArmyGrid",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "swissarmygrid.pushFile",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(csv|tsv|txt|json|jsonl|ndjson|parquet|arrow|feather|xlsx)$/i",
          "group": "navigation"
        },
        {
          "command": "swissarmygrid.showGrids",
          "group": "navigation@100"
        },
        {
          "command": "swissarmygrid.openInChrome",
          "group": "navigation@101"
        }
      ],
      "notebook/toolbar": [
        {
          "command": "swissarmygrid.showGrids",
          "group": "navigation/execute@10"
        },
        {
          "command": "swissarmygrid.openInChrome",
          "group": "navigation/execute@11"
        }
      ],
      "explorer/context": [
        {
          "command": "swissarmygrid.pushFile",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(csv|tsv|txt|json|jsonl|ndjson|parquet|arrow|feather|xlsx)$/i",
          "group": "navigation@90"
        }
      ],
      "commandPalette": [
        {
          "command": "swissarmygrid.pushFile",
          "when": "resourceScheme == file && resourceExtname =~ /^\\.(csv|tsv|txt|json|jsonl|ndjson|parquet|arrow|feather|xlsx)$/i"
        }
      ]
    },
    "configuration": {
      "title": "SwissArmyGrid",
      "properties": {
        "swissarmygrid.chromePath": {
          "type": "string",
          "default": "",
          "description": "The full path to Google Chrome, for the Open SAG in Chrome button. Leave empty to look in the usual places."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test": "npm run compile-tests && mocha \"out/test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npm run typecheck && npm run build && node bundle-server.mjs && node ../package-vsix.mjs",
    "test:integration": "npm run build && tsc -p tsconfig.integration.json && node out/test/integration/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "mocha": "^10.8.2",
    "typescript": "^5.6.3"
  }
}
