{
  "name": "swissarmygrid",
  "displayName": "SwissArmyGrid",
  "description": "SwissArmyGrid's tools for VS Code's agent mode, and a button that opens SwissArmyGrid. Install SwissArmyGrid itself with uv first.",
  "version": "1.7.0",
  "publisher": "dylancodybrown",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "https://github.com/DylanCodyBrown/SwissArmyGrid.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "swissarmygrid.open",
        "title": "Open SwissArmyGrid",
        "category": "SwissArmyGrid",
        "icon": {
          "light": "media/swissarmygrid.svg",
          "dark": "media/swissarmygrid.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "swissarmygrid.open",
          "group": "navigation@100"
        }
      ],
      "notebook/toolbar": [
        {
          "command": "swissarmygrid.open",
          "group": "navigation/execute@10"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "swissarmygrid",
        "label": "SwissArmyGrid"
      }
    ],
    "configuration": {
      "title": "SwissArmyGrid",
      "properties": {
        "swissarmygrid.chromePath": {
          "type": "string",
          "default": "",
          "description": "Google Chrome's full path, for opening SwissArmyGrid in its own window. Empty: the usual places, then the default browser."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test": "npm run compile-tests && mocha \"out/test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "npm run typecheck && npm run build && vsce package --no-dependencies --out ../dist/"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "mocha": "^10.8.2",
    "typescript": "^5.6.3"
  }
}
